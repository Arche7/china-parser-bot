# Скопируй этот файл в .env и впиши свои значения.
# Файл .env НЕЛЬЗЯ заливать на GitHub (он уже в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-твой-токен

# Токен Apify: console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxx

# Твой Telegram ID (узнать: напиши боту /id). Несколько — через запятую
ADMIN_IDS=123456789

# Минимальный интервал проверки, минут. Реальный интервал зависит от тарифа
# (START 30 / PRO 15 / ELITE 10), но чаще этого числа бот не проверит НИКОГДА.
# Хочешь сэкономить на старте — поставь 30: тогда все тарифы проверяются раз в 30 мин.
CHECK_INTERVAL_MIN=10

# Сколько свежих объявлений брать за один поисковый запрос
# (у брендов из brands.py обычно 2 запроса: латиница + по-китайски)
MAX_ITEMS=5


# Курс юаня к рублю (для подсказки "≈ ₽")
CNY_RUB_RATE=11.5

# Необязательные (можно не трогать):
# APIFY_ACTOR_ID=unitbytes/goofish-xianyu-search-scraper
# APIFY_PROXY_COUNTRY=HK
# APIFY_PRICE_PER_1000=1.6
# DB_PATH=bot.db

# ---------- HUNTR: новое ----------

# Ник поддержки без @ — сюда бот отправляет людей, которые хотят оплатить тариф
SUPPORT_USERNAME=

# Сколько дней длится бесплатный пробный период (0 — выключить)
TRIAL_DAYS=3

# Бонус пригласившему (дней), когда друг оформил тариф
REFERRAL_BONUS_DAYS=7

# Ссылка на мини-приложение HUNTR (появится позже). Пока пусто — кнопки нет.
WEBAPP_URL=

# ИИ: перевод заголовков и легит-чек. Подходит любой OpenAI-совместимый сервис.
# Пусто — ИИ выключен, заголовки переводит встроенный словарь.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o

# Сравнение цен с Авито через Apify (тот же APIFY_TOKEN). 0 — выключить.
AVITO_ENABLED=1
# AVITO_ACTOR_ID=ahaham_bytiz/avito-scraper
# AVITO_MAX_ITEMS=30
# AVITO_CACHE_HOURS=24

# Калькулятор выгоды по умолчанию (каждый может поменять у себя в настройках)
DELIVERY_RUB_PER_KG=1000
BUYER_FEE_PCT=5

# Курс доллара — только для подсказок о расходах в /stats
USD_RUB_RATE=82
