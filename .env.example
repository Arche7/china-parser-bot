# Скопируй этот файл в .env и впиши свои значения.
# Файл .env НЕЛЬЗЯ заливать на GitHub (он уже в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-твой-токен

# Токен Apify: console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxx

# Твой Telegram ID (узнать: напиши боту /id). Несколько — через запятую
ADMIN_IDS=123456789

# Как часто проверять новые объявления, минут
CHECK_INTERVAL_MIN=30

# Сколько свежих объявлений брать за одну проверку одного бренда
MAX_ITEMS=10

# Максимум брендов на одного пользователя
MAX_BRANDS_PER_USER=10

# Курс юаня к рублю (для подсказки "≈ ₽")
CNY_RUB_RATE=11.5

# Необязательные (можно не трогать):
# APIFY_ACTOR_ID=unitbytes/goofish-xianyu-search-scraper
# APIFY_PROXY_COUNTRY=HK
# APIFY_PRICE_PER_1000=1.6
# DB_PATH=bot.db
